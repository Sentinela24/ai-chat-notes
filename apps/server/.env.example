# Copy to apps/server/.env (never commit .env).
# With no .env at all, the server runs in MOCK mode: no API key needed.

# mock | anthropic | openai
LLM_PROVIDER=mock

# --- Anthropic ---
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max | off ("off" omits the parameter, for older models)
# ANTHROPIC_EFFORT=low
# Server-side refusal fallback. Defaults to on for models that support it.
# ANTHROPIC_FALLBACKS=on

# --- OpenAI ---
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-5-mini

# --- Mock ---
# Delay between mock tokens in ms.
# MOCK_DELAY_MS=30

# PORT=8787
