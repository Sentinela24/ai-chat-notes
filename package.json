{
  "name": "ai-chat-notes",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A small AI-native chat + notes app: streamed LLM replies over SSE, TipTap notes with streamed AI rewrites.",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -n server,web -c blue,magenta \"npm run dev -w apps/server\" \"npm run dev -w apps/web\"",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "tsc -p tsconfig.json && npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "npm run test --workspaces --if-present",
    "test:e2e": "playwright test",
    "storybook": "npm run storybook -w apps/web",
    "screenshots": "tsx scripts/screenshots.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.6",
    "concurrently": "^10.0.7",
    "eslint": "^10.15.0",
    "eslint-plugin-import-x": "^4.18.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "postcss-selector-parser": "^6.1.5",
    "@joshwooding/vite-plugin-react-docgen-typescript": {
      "glob": "^14.0.2"
    }
  }
}
